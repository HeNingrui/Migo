# ===========================================================================
# Configuration -- OpenAI (ChatGPT)
#
# Copy to .env, then fill in LLM_API_KEY:
#
#     Copy-Item .env.openai.example .env
#
# .env is git-ignored; this file is not. Never put a real key in a *.example
# file, and never commit .env.
#
# Only the LLM block differs from .env.deepseek.example. Everything above it is
# shared; the per-setting notes live there.
# ===========================================================================


# --- Catalog (member D) ----------------------------------------------------
# LIVE: app/db/core.py. Relative paths resolve against the repository root.
DEMO_DB_PATH=var/demo.sqlite3

# PLANNED: nothing reads this yet.
DEMO_PRINCIPAL_ID=demo_user


# --- Payment boundary (member C) -------------------------------------------
# All PLANNED. See .env.deepseek.example for what each one means.
PAYMENT_MODE=sandbox
CAPABILITY_SIGNING_KEY=dev-only-capability-key-not-for-production
CAPABILITY_TTL_SECONDS=60
PLATFORM_FEE_CENTS=0
SANDBOX_SHIPPING_CENTS=1000


# --- LLM boundary (member A) ------------------------------------------------
# LIVE: scripts/probe_llm_format.py reads all four.
#
#   LLM_BASE_URL  OpenAI's API root is https://api.openai.com/v1. The /v1 belongs
#                 to the root; only /chat/completions is appended.
#   LLM_MODEL     gpt-4o-mini is the cheap default and supports JSON mode, which
#                 is what this probe relies on. Swap in whatever your account
#                 has: gpt-4o, gpt-4.1, gpt-4.1-mini and the o-series also work,
#                 though the o-series can be slow and may return empty content
#                 when its output budget goes on reasoning.
#   LLM_API_KEY   the only value you must supply. Never commit it.
#   LLM_TIMEOUT_SECONDS
#                 the mandate case sends a long sentence plus a large schema.
#                 15s is tight; 60s is comfortable.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60


# --- Test data paths (optional) --------------------------------------------
# LIVE: the fixture tools and tests/search/. Both default to the right place.
#HACKU_CATALOG=data/products.seed.json
#HACKU_FIXTURES=fixtures
