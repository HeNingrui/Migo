    "/api/v1/health": {
      "get": {
        "tags": [
          "agent"
        ],
        "summary": "Health",
        "description": "Whether the pieces this process needs are actually there.\n\nThe database status is D's own check, reused rather than re-implemented; the\ncommerce half is C's reconciliation reader, which reports holds with no\nrecorded outcome and re-verifies the audit chain. A health endpoint that only\nsays \"ok\" cannot tell a reviewer which of those is broken.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/chat": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Chat",
        "description": "One conversational turn.",
        "operationId": "chat_api_v1_agent_chat_post",
        "requestBody": {
