# ===========================================================================
# Configuration -- DeepSeek
#
# Copy to .env, then fill in LLM_API_KEY:
#
#     Copy-Item .env.deepseek.example .env
#
# .env is git-ignored; this file is not. Never put a real key in a *.example
# file, and never commit .env.
#
# Each setting is marked:
#   LIVE     something in this repository reads it today
#   PLANNED  the owner has not written the reader yet. The name is agreed, the
#            value is harmless to keep, and nothing will notice if it is wrong.
# ===========================================================================


# --- Catalog (member D) ----------------------------------------------------
# LIVE: app/db/core.py. Relative paths resolve against the repository root.
DEMO_DB_PATH=var/demo.sqlite3

# PLANNED: nothing reads this yet. The fixed demo principal; real authentication
# replaces it later without changing any business service signature.
DEMO_PRINCIPAL_ID=demo_user


# --- Payment boundary (member C) -------------------------------------------
# All PLANNED. app/commerce/ currently contains only policy_evaluator.py, which
# is a pure function and deliberately reads no configuration at all. These are
# the agreed names so the values do not have to be invented at integration time.

# sandbox : every payment adapter is a local mock. No network, no real money.
# Anything else must be implemented and reviewed before use.
PAYMENT_MODE=sandbox

# MUST be overridden outside local demo use. The development default exists only
# so the demo runs with no setup.
CAPABILITY_SIGNING_KEY=dev-only-capability-key-not-for-production

# The spec requires capability lifetimes to stay short.
CAPABILITY_TTL_SECONDS=60

# Platform fee in minor units, charged on top of the merchant total. 0 means
# there is no fee; it is not an observation of one.
PLATFORM_FEE_CENTS=0

# Flat shipping charged by the sandbox merchant in minor units, i.e. HK$10.
# The product data has no shipping field, so this is a demo parameter and must
# never be presented as an observed rate.
SANDBOX_SHIPPING_CENTS=1000


# --- LLM boundary (member A) ------------------------------------------------
# LIVE: scripts/probe_llm_format.py reads all four, and LLMIntentParser will use
# the same names. Any OpenAI-compatible /chat/completions endpoint works.
#
#   LLM_BASE_URL  the API root. /chat/completions is appended for you, so do not
#                 include it here.
#   LLM_MODEL     deepseek-chat is the fast general model. deepseek-reasoner also
#                 works but is slower and can return empty content when its
#                 output budget is spent on reasoning.
#   LLM_API_KEY   the only value you must supply. Never commit it, and never put
#                 a working key in this file: it is the template, and the
#                 template is tracked. Leave it empty and set it in .env, which
#                 is git-ignored.
#   LLM_TIMEOUT_SECONDS
#                 the mandate case sends a long sentence plus a large schema.
#                 15s is tight; 60s is comfortable.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60


# --- Test data paths (optional) --------------------------------------------
# LIVE: scripts/gen_fixtures.py, scripts/check_fixtures.py and
# tests/search/test_search_fixtures.py. Both already default to the right place,
# so these only matter if you want to point the tools somewhere else.
#HACKU_CATALOG=data/products.seed.json
#HACKU_FIXTURES=fixtures
